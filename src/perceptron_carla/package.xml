<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perceptron_carla</name>
  <version>0.1.0</version>
  <description>CARLA simulator bridge for the Perceptron rover: rover-geometry sensors, simulated IMU/wheel odometry/GNSS, ground truth, and localization evaluation</description>
  <maintainer email="dev@todo.todo">Perceptron Developer</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>perceptron_navigation</depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- The carla 0.9.15 Python client comes from pip (see README), it is not a rosdep key. -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
